# Spotra — copy to .env.local and fill in values from your Supabase project

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (must be https for link previews): https://spotra.dev

# Transactional email (Resend) — optional in local dev
# Without RESEND_API_KEY, welcome/claim emails are skipped and logged.
RESEND_API_KEY=
# Verified sender, e.g. Spotra <hello@spotra.dev>
# Until your domain is verified, Resend allows: Spotra <onboarding@resend.dev>
RESEND_FROM_EMAIL=Spotra <onboarding@resend.dev>
